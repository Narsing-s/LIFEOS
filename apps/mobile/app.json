{
  "expo": {
    "name": "LIFEOS",
    "slug": "lifeos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lifeos",
    "userInterfaceStyle": "automatic",
    "android": { "package": "com.narsing.lifeos" },
    "ios": { "bundleIdentifier": "com.narsing.lifeos" },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiUrl": "${EXPO_PUBLIC_API_URL}"
    }
  }
}
