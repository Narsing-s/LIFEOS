{
  "name": "lifeos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @lifeos/api --filter @lifeos/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @lifeos/database prisma:generate",
    "db:migrate": "pnpm --filter @lifeos/database prisma:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}